---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	authorize(authorize)
	agent(agent)
	confirm(confirm)
	tools(tools)
	__end__([<p>__end__</p>]):::last
	__start__ --> authorize;
	agent -.-> __end__;
	agent -.-> confirm;
	agent -.-> tools;
	authorize -.-> __end__;
	authorize -.-> agent;
	confirm -.-> __end__;
	confirm -.-> tools;
	tools --> agent;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
