# terraform.tfvars.example
# Purpose: Copy to terraform.tfvars (or an environments/<env>/terraform.tfvars)
# and fill in. Do NOT commit real secrets. Set TF_VAR_order_api_key in your
# shell or CI secret store instead.

project_name = "wa-ai-rpa"
environment  = "dev"
aws_region   = "us-east-1"

tags = {
  Owner      = "platform-team"
  CostCenter = "cc-1234"
}

# --- Messaging / WhatsApp (IDs come from the manual linking flow) ---
whatsapp_business_account_id = "" # e.g. "123456789012345" after linking in the console
whatsapp_phone_number_id     = "" # e.g. "phone-number-id-0123456789abcdef0123456789abcdef"
sns_kms_master_key_id        = "" # never alias/aws/sns (End User Messaging Social can't use it)
meta_api_version             = "v20.0"

# --- SQS ---
sqs_visibility_timeout_seconds = 1080 # >= lambda_timeout, 6x recommended
sqs_message_retention_seconds  = 345600
sqs_max_receive_count          = 5
sqs_enable_dlq                 = true

# --- DynamoDB (four tables, named <prefix>_<key>_table) ---
dynamodb_table_name_prefix   = "hackathon"
dynamodb_billing_mode        = "PAY_PER_REQUEST"
dynamodb_enable_pitr         = true
dynamodb_deletion_protection = false
dynamodb_sse_type            = "AWS_OWNED" # AWS_OWNED | AWS_MANAGED | CUSTOMER_MANAGED
dynamodb_kms_key_arn         = ""          # required for CUSTOMER_MANAGED

dynamodb_tables = {
  user         = { hash_key = "user_id" }
  mapping      = { hash_key = "conversation_id" }
  checkpointer = { hash_key = "pk", range_key = "sk", ttl_attribute = "expires_at" }
  chat_history = { hash_key = "conversation_id", range_key = "sk" }
  # Optional per table: name = "exact_table_name", ttl_attribute = "expires_at",
  # hash_key_type / range_key_type = "S" | "N" | "B"
}

# --- Bedrock AI agent ---
ai_agent_enabled                = true
bedrock_mode                    = "model"
bedrock_model_id                = "us.amazon.nova-2-lite-v1:0"
bedrock_existing_agent_id       = ""
bedrock_existing_agent_alias_id = ""

# --- Lambda ---
lambda_runtime      = "python3.12"
lambda_handler      = "app.lambda_handler"
lambda_timeout      = 180
lambda_memory_size  = 1024
lambda_batch_size   = 1
lambda_log_level    = "INFO"
lambda_architecture = "x86_64"
# Code and layer are deployed by the App pipeline (.github/workflows/app.yml).

# Function URL for /, /ask and /callback (NONE = public, unauthenticated)
lambda_function_url_enabled   = false
lambda_function_url_auth_type = "NONE"

# --- RPA (external UiPath Orchestrator) ---
order_api_endpoint = "https://cloud.uipath.com/<org>/<tenant>/orchestrator_/t/<id>/api_process"
# order_api_key: set $env:TF_VAR_order_api_key, never commit it here.
